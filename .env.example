# Copy to .env and fill in. Everything personal lives here, never in code.

#OPENAI_API_KEY=sk-...

# Absolute path of your vault on the host (any folder of markdown
# notes; an Obsidian vault works as-is), mounted read-only at
# /vault inside the containers. On WSL, C:\ becomes /mnt/c/.
# Leave unset to use the committed demo_vault. The shortcut
# `make vault VAULT=/abs/path` writes this line and applies it.
#VAULT_PATH=/mnt/c/Users/you/Documents/your-vault

# LLM provider. Default is the OpenAI API with gpt-5.4-mini for answers.
# A local ollama service ships with the stack and is born with a basic
# model (qwen2.5:1.5b), so local answers work with no key and no setup;
# better local models are one Download click away in the app's sidebar
# (Local models). LLM_MODEL just picks the default selection in the app.
#LLM_MODEL=qwen2.5:7b-instruct
# LLM_BASE_URL is only for an EXTERNAL OpenAI-compatible server (LM
# Studio, ollama on the host, vLLM) instead of the bundled one. Apply
# .env changes with make reload-app (a restart does not reread this):
#LLM_BASE_URL=
# Only needed when that external server validates keys (ollama does
# not); sent as the api key for LLM_BASE_URL requests.
#LLM_API_KEY=

# NVIDIA gpu for the local models (optional, needs the
# nvidia-container-toolkit):
#   cp docker-compose.gpu.yml docker-compose.override.yml && docker compose up -d

# Overrides (defaults shown)
#JUPYTER_TOKEN=dev
#POSTGRES_USER=user
#POSTGRES_PASSWORD=pswd
#GRAFANA_PASSWORD=admin
#EMBED_MODEL=all-MiniLM-L6-v2
#ES_INDEX=obsidian_notes

# Host ports. Change here if something on your machine already uses one;
#APP_PORT=8501
#JUPYTER_PORT=8888
#GRAFANA_PORT=3000
#ES_PORT=9200
#POSTGRES_PORT=5432
#OLLAMA_PORT=11434
